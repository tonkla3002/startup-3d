# --- App ---
# local | sandbox | production
APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://streamora:streamora@localhost:55432/streamora
# Fernet key สำหรับเข้ารหัส token ของร้านค้าใน DB
TOKEN_ENCRYPTION_KEY=

# --- Auth ของผู้ใช้ระบบ (PROJECT_RULES section 4.7) ---
# session middleware — ต้องคนละค่ากับ JWT_SECRET_KEY
SECRET_KEY=
# ออก access token ของแอป
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# เช่น https://api.example.com
OAUTH_REDIRECT_BASE_URL=

# --- Lazada (App: Miot) ---
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_API_BASE_URL=https://api.lazada.co.th/rest
LAZADA_AUTH_BASE_URL=https://auth.lazada.com/rest
LAZADA_AUTHORIZE_URL=https://auth.lazada.com/oauth/authorize
LAZADA_REDIRECT_URI=https://example.ngrok.app/api/v1/auth/lazada/callback
LAZADA_COUNTRY=TH

# --- Shopee (ยังไม่ได้ credential) ---
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_API_BASE_URL=https://partner.test-stable.shopeemobile.com
SHOPEE_REDIRECT_URI=

# --- TikTok Shop (ยังไม่เริ่ม) ---
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_API_BASE_URL=https://open-api.tiktokglobalshop.com
TIKTOK_REDIRECT_URI=
